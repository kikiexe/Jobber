# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=set-your-model-here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Sender Details
DEFAULT_SENDER_NAME=Your Name

# Developer CV Configuration
DEV_CV_PATH=cv-dev-Putra Ajril Fatah.pdf
DEV_PORTFOLIO_PATH=Portofolio-Putra Ajril Fatah.pptx
DEV_CV_SUMMARY_PATH=cv-dev.md

# F&B / Barista CV Configuration
FNB_CV_PATH=cv-fnb-Putra Ajril Fatah.pdf
FNB_CV_SUMMARY_PATH=cv-fnb.md

# Bot Security Configuration
ALLOWED_TELEGRAM_USERNAME=your_username_here
